+++ b/dcgmlib/src/DcgmApi.cpp
@@ -5698,10 +5698,8 @@ dcgmReturn_t StartEmbeddedV2(dcgmStartEmbeddedV2Params_v1 &params)
         if (chdir(homeDir))
         {
             char errbuf[1024];
-            strerror_r(errno, errbuf, sizeof(errbuf));
-
             std::string cwd(std::filesystem::current_path());
-            homeDirMsg = fmt::format("Couldn't change to directory '{}' from '{}': {}.", homeDir, cwd, errbuf);
+            homeDirMsg = fmt::format("Couldn't change to directory '{}' from '{}': {}.", homeDir, cwd, strerror_r(errno, errbuf, sizeof(errbuf)));
             chdirFail  = true;
         }
     }
