diff --git a/common/DcgmError.h b/common/DcgmError.h
index 87ded8a..4f02c7c 100755
--- a/common/DcgmError.h
+++ b/common/DcgmError.h
@@ -251,7 +251,10 @@ private:
     {                                                                              \
         char buf_2M8SD15I[1024];                                                   \
         const char *fmt_2M8SD15I = dcgmGetErrorMeta(errCode)->msgFormat;           \
+        _Pragma("GCC diagnostic push")                                            \
+        _Pragma("GCC diagnostic ignored \"-Wformat-security\"")                   \
         snprintf(buf_2M8SD15I, sizeof(buf_2M8SD15I), fmt_2M8SD15I, ##__VA_ARGS__); \
+        _Pragma("GCC diagnostic pop")                                              \
         errorObj.SetMessage(buf_2M8SD15I);                                         \
         errorObj.SetNextSteps(dcgmGetErrorMeta(errCode)->suggestion);              \
         errorObj.SetCode(errCode);                                                 \
diff --git a/common/DcgmUtilities.cpp b/common/DcgmUtilities.cpp
index 9909fb4..134e4bf 100644
--- a/common/DcgmUtilities.cpp
+++ b/common/DcgmUtilities.cpp
@@ -873,15 +873,13 @@ dcgmReturn_t RunCmdAndGetOutput(std::string const &cmd, std::string &output)
     int readOutputRet = DcgmNs::Utils::ReadProcessOutput(stdoutStream, std::move(outputFd));
     if (readOutputRet)
     {
-        strerror_r(readOutputRet, errbuf, sizeof(errbuf));
-        errmsg = fmt::format("Output of '{}' couldn't be read: '{}'. ", cmd, errbuf);
+        errmsg = fmt::format("Output of '{}' couldn't be read: '{}'. ", cmd, strerror_r(readOutputRet, errbuf, sizeof(errbuf)));
     }
 
     int childStatus;
     if (waitpid(childPid, &childStatus, 0) == -1)
     {
-        strerror_r(errno, errbuf, sizeof(errbuf));
-        errmsg += fmt::format("\nError while waiting for child process ({}) to exit: '{}'", childPid, errbuf);
+        errmsg += fmt::format("\nError while waiting for child process ({}) to exit: '{}'", childPid, strerror_r(errno, errbuf, sizeof(errbuf)));
     }
     else if (WIFEXITED(childStatus))
     {
